{
  "cli": {
    "version": ">= 10.0.0"
  },
  "build": {
    "preview": {
      "channel": "preview",
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "image": "sdk-54"
      },
      "ios": {
        "simulator": false
      },
      "env": {
        "ORG_GRADLE_PROJECT_newArchEnabled": "true",
        "EXPO_PUBLIC_API_BASE": "https://tours-dar-tamaiz--engalialfoudari.replit.app/api"
      },
      "node": "22.14.0"
    },
    "production": {
      "channel": "production",
      "android": {
        "buildType": "app-bundle",
        "image": "sdk-54"
      },
      "env": {
        "ORG_GRADLE_PROJECT_newArchEnabled": "true",
        "EXPO_PUBLIC_API_BASE": "https://tours-dar-tamaiz--engalialfoudari.replit.app/api"
      },
      "node": "22.14.0"
    }
  }
}
