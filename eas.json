{
  "cli": { "version": ">= 10.0.0" },
  "build": {
    "preview": {
      "channel": "preview",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      },
      "env": {
        "ORG_GRADLE_PROJECT_newArchEnabled": "true",
        "EXPO_PUBLIC_API_BASE": "https://tours-dar-tamaiz--engalialfoudari.replit.app/api"
      }
    },
    "production": {
      "channel": "production",
      "node": "22.14.0",
      "android": {
        "buildType": "app-bundle",
        "image": "sdk-54"
      },
      "env": {
        "ORG_GRADLE_PROJECT_newArchEnabled": "true",
        "EXPO_PUBLIC_API_BASE": "https://dt-tour.com/api",
        "EXPO_PUBLIC_DOMAIN": "dt-tour.com"
      }
    }
  }
}
